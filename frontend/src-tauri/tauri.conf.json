{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "quest",
	"version": "0.1.0",
	"identifier": "org.scottylabs.quest",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"title": "O-Quest",
				"width": 800,
				"height": 600
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"iOS": {
			"developmentTeam": "4Y39FMA838"
		}
	},
	"plugins": {
		"deep-link": {
			"mobile": [],
			"desktop": {
				"schemes": ["quest"]
			}
		}
	}
}
